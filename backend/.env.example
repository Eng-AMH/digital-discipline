# Digital Discipline Platform — environment configuration.
# Copy to `.env` and fill in real values. NEVER commit a real .env file.
# Every variable below is actually read somewhere in config/settings.py or
# docker-compose.yml — this list was generated by grepping both files, not
# written from memory, so it should not silently omit anything required.

# --- Core Django ---
DJANGO_SECRET_KEY=                          # required in production; generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_DEBUG=false                          # true only for local development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1    # comma-separated, no spaces

# --- Database ---
# If unset, falls back to local SQLite (dev-only fallback — see settings.py
# comment). docker-compose.yml constructs this automatically from
# POSTGRES_PASSWORD below; only set DATABASE_URL directly for a non-Docker deploy.
DATABASE_URL=
POSTGRES_PASSWORD=                          # required by docker-compose.yml

# --- Redis / Celery / Channels ---
REDIS_URL=redis://localhost:6379/0

# --- CORS (web frontend origin, once built) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Unlock token / device identity signing (architecture doc §5.2/§5.3) ---
# REQUIRED for anything beyond local dev. Generate with:
#   python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; \
#              import base64; k=Ed25519PrivateKey.generate(); \
#              print(base64.b64encode(k.private_bytes_raw()).decode())"
# NEVER reuse the dev-only default baked into settings.py in any real deployment.
UNLOCK_TOKEN_SIGNING_KEY_B64=

# --- AI Coach provider (architecture doc §6) ---
# 'mock' is the only implemented value in this build — see apps/ai_coach/services.py
AI_COACH_PROVIDER=mock

# --- Payment providers (architecture doc §0.2/§7) ---
# Leave blank to keep the corresponding webhook endpoint returning 501
# Not Implemented rather than accepting unverifiable webhooks — see
# apps/monetization/views.py module docstring for why this is deliberate.
STRIPE_WEBHOOK_SECRET=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
APPLE_IAP_SHARED_SECRET=

# --- Push notifications (architecture doc §44) ---
# Leave blank to keep Notification rows created in the DB but not pushed via
# FCM — see apps/notifications/services.py.
FCM_SERVER_KEY=

# Production / free-tier deployment
CSRF_TRUSTED_ORIGINS=https://YOUR-WEB-FRONTEND.example
DJANGO_SECURE_SSL_REDIRECT=false
REDIS_URL=
